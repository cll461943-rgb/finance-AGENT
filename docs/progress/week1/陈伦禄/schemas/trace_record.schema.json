{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/regrag/trace-record.schema.json",
  "title": "RegRAG TraceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "query_id", "started_at", "steps", "final_status"],
  "properties": {
    "trace_id": {"type": "string"},
    "query_id": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_no", "module", "input_ref", "output_ref", "status", "elapsed_ms"],
        "properties": {
          "step_no": {"type": "integer", "minimum": 1},
          "module": {"enum": ["query_parser", "retriever", "reranker", "evidence_gate", "tool", "generator", "validator"]},
          "input_ref": {"type": ["string", "null"]},
          "output_ref": {"type": ["string", "null"]},
          "status": {"enum": ["success", "warning", "failed", "skipped"]},
          "message": {"type": ["string", "null"]},
          "elapsed_ms": {"type": "number", "minimum": 0}
        }
      }
    },
    "final_status": {"enum": ["answered", "clarify", "refused", "conflict", "error"]},
    "token_usage": {"type": ["integer", "null"], "minimum": 0},
    "total_cost": {"type": ["number", "null"], "minimum": 0}
  }
}
